# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/support_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# AI Integration Environment Variables
AI_PROVIDER=openai                 # Options: openai, gemini, ollama, builtin-rag
AI_API_KEY=sk-your-openai-or-gemini-api-key-here
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=500
AI_FALLBACK_ENABLED=true
